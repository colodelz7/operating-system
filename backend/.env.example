# ============================================================
#  Sistema Operacional :: variaveis de ambiente
# ============================================================
# Copie este arquivo para ".env" e ajuste os valores.
#   cp .env.example .env

# Porta do servidor (3000 costuma estar ocupada por outro projeto)
PORT=3001

# Interface de escuta. 127.0.0.1 = so a propria maquina (padrao seguro).
# Para expor na rede (ou no container da hospedagem), defina HOST=0.0.0.0
# de proposito. Sem essa variavel o servidor NAO fica acessivel de fora.
HOST=127.0.0.1

# ------------------------------------------------------------
#  SESSAO  (obrigatorio)
# ------------------------------------------------------------
# Nao existe valor padrao no codigo: sem um segredo forte aqui o servidor
# se recusa a iniciar. Minimo de 32 caracteres. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Nome do cookie de sessao (generico de proposito)
COOKIE_NAME=operacional.sid

# ------------------------------------------------------------
#  BANCO DE DADOS
# ------------------------------------------------------------
# Enquanto DATABASE_URL estiver VAZIO/comentado, o sistema roda
# com um armazenamento EM MEMORIA (dados de teste, resetam ao
# reiniciar). Perfeito para testar a logica agora.
#
# Quando for hospedar: crie o banco Postgres, rode os arquivos
# db/schema.sql e db/seed.sql, e preencha a linha abaixo.
# O codigo passa a usar o Postgres automaticamente, sem mudar
# mais nada.
#
# DATABASE_URL=postgres://usuario:senha@localhost:5432/operacional

# Em producao (HTTPS), deixe como "true" para cookie seguro:
COOKIE_SECURE=false

# ------------------------------------------------------------
#  API pura / proxy reverso
# ------------------------------------------------------------
# Em producao o Node roda atras de um proxy (nginx/host) que serve
# o build do frontend e encaminha /api para ca. Deixe "true" para
# o cookie secure e o rate-limit enxergarem o IP real do cliente.
TRUST_PROXY=false

# ------------------------------------------------------------
#  RATE LIMIT do login (mitiga forca bruta)
# ------------------------------------------------------------
LOGIN_RATE_WINDOW_MS=900000   # 15 min
LOGIN_RATE_MAX=10             # tentativas com falha por IP por janela

# ------------------------------------------------------------
#  BLOQUEIO TEMPORARIO do login (por IP e por conta)
# ------------------------------------------------------------
LOGIN_BLOQUEIO_TENTATIVAS=3   # falhas seguidas ate travar
LOGIN_BLOQUEIO_MS=300000      # 5 min de bloqueio
