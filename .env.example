# ============================================================
#  Variaveis do docker compose. Copie para ".env" e ajuste.
# ============================================================
# Segredo da sessao (obrigatorio, minimo 32 caracteres). Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
COOKIE_NAME=operacional.sid

# Vazio = API em memoria (dados resetam ao recriar o container).
# PREENCHIDO = e obrigatorio subir com o profile do banco:
#   docker compose --profile pg up -d
DATABASE_URL=

POSTGRES_USER=operacional
POSTGRES_PASSWORD=
POSTGRES_DB=operacional


# ------------------------------------------------------------
#  ASSISTENTE (ColodelBot dentro do sistema)
# ------------------------------------------------------------
# Chave do Google AI Studio. Fica so no servidor: o navegador nunca a
# recebe. Sem ela, o botao do assistente simplesmente nao aparece.
GEMINI_API_KEY=
# Modelo e reserva. Os padroes do codigo ja funcionam; troque so se precisar.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_RESERVA=gemini-3.5-flash-lite
