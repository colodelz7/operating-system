# ============================================================
#  Variaveis do docker compose. Copie para ".env" e ajuste.
# ============================================================
# Segredo da sessao (obrigatorio, minimo 32 caracteres). Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
COOKIE_NAME=operacional.sid

# Vazio = API em memoria (dados resetam ao recriar o container).
# PREENCHIDO = e obrigatorio subir com o profile do banco:
#   docker compose --profile pg up -d
DATABASE_URL=

POSTGRES_USER=operacional
POSTGRES_PASSWORD=
POSTGRES_DB=operacional


# ------------------------------------------------------------
#  ASSISTENTE (ColodelBot dentro do sistema)
# ------------------------------------------------------------
# Chave do Google AI Studio. Fica so no servidor: o navegador nunca a
# recebe. Sem ela, o botao do assistente simplesmente nao aparece.
GEMINI_API_KEY=
# Modelo e reserva. Os padroes do codigo ja funcionam; troque so se precisar.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_RESERVA=gemini-3.5-flash-lite

# ------------------------------------------------------------
#  COFRE DE ACESSOS (senhas dos clientes, cifradas)
# ------------------------------------------------------------
# 32 bytes em base64. Vazio = cofre desligado. NAO troque depois de usar:
# as senhas guardadas so abrem com a mesma chave. Gere a sua:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COFRE_CHAVE=

# ------------------------------------------------------------
#  NOTIFICACOES PUSH (aviso no celular e no computador)
# ------------------------------------------------------------
# Vazio = push desligado (o resto funciona normal). Gere o par com:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contato do responsavel pelo servidor (mailto: ou https:)
VAPID_SUBJECT=mailto:voce@exemplo.com

# ------------------------------------------------------------
#  LANCADOR "Trocar de sistema" (frontend, vai no build)
# ------------------------------------------------------------
# Lista em JSON; vazio = sem botao. "setores" e opcional (slugs).
# VITE_SISTEMAS=[{"nome":"Sistema Comercial","descricao":"Vendas e contratos","url":"https://comercial.exemplo.com","setores":["comercial"]}]
VITE_SISTEMAS=
